WATCHER_ENV=production
WATCHER_DATA_DIR=/var/lib/school-watcher
WATCHER_HOST=127.0.0.1
WATCHER_PORT=5000
WATCHER_TRUST_PROXY=1
WATCHER_DOMAIN=replace-with-your-domain.example
# Set a persistent randomly generated secret before first start; never commit it.
SECRET_KEY=
# Optional mounted backup destination, outside the application data disk.
# Add this destination to the worker service ReadWritePaths as well.
WATCHER_BACKUP_COPY_DIR=
