# Optional settings for the Windows desktop launcher.
# Copy to .env only if you need to override defaults; never commit .env.
# Server deployments use deploy/server.env.example instead.
WATCHER_HOST=127.0.0.1
WATCHER_PORT=5000
WATCHER_BROWSER=1
WATCHER_BROWSER_CONCURRENCY=1

# Default data location is ./data. Use one shared directory for all local processes.
# WATCHER_DATA_DIR=D:/SchoolWatcher/data

# The launcher generates SECRET_KEY, the encryption key and the browser token.
# Do not put example secrets here or replace generated keys on an existing instance.
# Configure optional AI credentials through the administrator settings page.
