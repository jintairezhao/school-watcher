{
  "type": "object",
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "decision": {
            "enum": [
              "propose",
              "review",
              "explore",
              "choose",
              "not_column"
            ]
          },
          "config": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "list_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "list_selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title_selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "link_selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "date_selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "content_selector": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "group_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pagination_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "list_url",
              "list_selector",
              "title_selector",
              "link_selector",
              "date_selector",
              "content_selector",
              "group_name",
              "pagination_url"
            ],
            "additionalProperties": false
          },
          "scope_evidence": {
            "type": "object",
            "properties": {
              "container_selector": {"type": "string", "minLength": 1, "maxLength": 500},
              "heading_selector": {"type": "string", "minLength": 1, "maxLength": 500}
            },
            "required": ["container_selector", "heading_selector"],
            "additionalProperties": false
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "reason": {
            "type": "string",
            "maxLength": 1000
          },
          "needed_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "read_page",
                    "read_reference"
                  ]
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "purpose": {
                  "enum": [
                    "directory",
                    "list",
                    "article"
                  ]
                },
                "reference": {
                  "enum": [
                    "identity",
                    "page-types",
                    "extraction-patterns"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "type",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "publisher_evidence": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 200
              },
              "directory_evidence_id": {
                "type": "string",
                "maxLength": 200
              },
              "homepage_evidence_id": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "name",
              "directory_evidence_id",
              "homepage_evidence_id"
            ],
            "additionalProperties": false
          },
          "question": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "field": {
                      "enum": [
                        "list_url"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "evidence_ids": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "field",
                    "value",
                    "evidence_ids"
                  ],
                  "additionalProperties": false
                }
              },
              "purpose": {
                "const": "subscription_preference"
              }
            },
            "required": [
              "text",
              "options",
              "purpose"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "candidate_id",
          "decision",
          "config",
          "evidence_ids",
          "reason",
          "needed_evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "proposals"
  ],
  "additionalProperties": false
}
